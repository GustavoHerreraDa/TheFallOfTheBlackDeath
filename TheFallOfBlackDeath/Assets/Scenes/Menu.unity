    - target: {fileID: 3556626363055895420, guid: db5dd250aa2b61749b1a6ff35cf2445f, type: 3}
      propertyPath: m_text
      value: "The cycle persists: lives for the village, a beast that feeds on blood
        and time \u2014 yet in every generation one of the sacrificed dares to dream
        of breaking the curse and driving a blade into the deformity at the Maze\u2019s
        heart."
      objectReference: {fileID: 0}
    - target: {fileID: 3556626363055895420, guid: db5dd250aa2b61749b1a6ff35cf2445f, type: 3}
      propertyPath: m_sharedMaterial
      value: 
      objectReference: {fileID: 5582758663094175588, guid: f401befd36f7c4f42a8a20273dc70291, type: 2}
    - target: {fileID: 3556626363055895420, guid: db5dd250aa2b61749b1a6ff35cf2445f, type: 3}
      propertyPath: m_hasFontAssetChanged
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3556626363122273621, guid: db5dd250aa2b61749b1a6ff35cf2445f, type: 3}
      propertyPath: m_text
      value: "Centuries ago our people defied the gods and, as punishment, from the
        earth\u2019s womb rose an undying Guardian, a grotesque fusion of sin, hatred
        and flesh condemned to dwell in the depths of the Maze."
      objectReference: {fileID: 0}
    - target: {fileID: 3556626363122273621, guid: db5dd250aa2b61749b1a6ff35cf2445f, type: 3}
      propertyPath: m_sharedMaterial
